{
  "name": "ai-content-generator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "install-all": "npm install",
    "build": "npm run build --workspace=src/frontend",
    "dev": "concurrently \"npm run dev --workspace=src/backend\" \"npm run dev --workspace=src/frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
